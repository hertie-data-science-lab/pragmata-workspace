# Copy to .env and fill in. .env is gitignored; this template is committed.
# Loaded by scripts/lib/common.sh for every pipeline stage.

# --- Argilla (annotation instance) ---
ARGILLA_API_URL=https://argilla.example.internal
ARGILLA_API_KEY=replace-me

# --- LLM (querygen) ---
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1

# --- pragmata pipeline source checkout (provides the `pragmata` CLI) ---
# Pinned at the demo checkout the live Argilla instance was built from, so
# annotation and export behaviour stays frozen. Do NOT move it forward to pick up
# eval work — use PRAGMATA_EVAL_SRC below.
PRAGMATA_SRC=/path/to/pragmata/src

# --- pragmata source for the eval stage only (scripts/eval/) ---
# The demo pin above has no eval module, so eval gets its own pin and can track
# upstream independently. Point this at a checkout on the report's pin branch,
# `pin/eval-report-2026-07`: upstream main plus the two eval-score PRs the report
# depends on (#305 panel-completeness skipping, #304 score-by-path), which are
# pending review. Not main, and not either feature branch on its own — the pin
# branch is the reviewed combination the numbers were produced from, and every
# provenance sidecar records its branch and SHA.
# Only a source tree is needed: the eval CLI is the workspace venv's own `pragmata`
# run with this path on PYTHONPATH, which shadows the installed package.
PRAGMATA_EVAL_SRC=/path/to/pragmata/src

# --- publikationsbot (retrieval/answer backend) ---
PUBLIKATIONSBOT_URL=https://publikationsbot.example.internal

# --- eval data transport (Azure Blob; used by scripts/transfer/sync.sh) ---
# Shared drop-point between the CPU annotation box and the GPU eval box.
# The SAS is data-plane auth (no ARM rights needed) — keep the real token in
# .env only. Ask the storage owner for a token that outlives the eval work, or
# document its rotation, so long transfers don't break on expiry.
EVAL_BLOB_ACCOUNT=replace-me
EVAL_BLOB_CONTAINER=replace-me
EVAL_BLOB_SAS=replace-me
