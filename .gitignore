# --- secrets / credentials (never commit) ---
.env
configs/annotation/users.secrets.json
# annotator roster (names); kept local, not version-controlled
configs/annotation/users.json
# deployment identifiers (hosts, tenant/subscription IDs, accounts); §2.1 of the
# implementation guide relies on this pattern - the repository is public.
*.local.md

# --- python virtualenv ---
# No trailing slash: a bare `.venv/` matches a directory only, so a `.venv` that is a
# symlink slips through and gets committed (it did, in #80, pointing at itself).
.venv
# uv's interpreter + wheel cache, kept in-tree so a checkout shared between users
# does not depend on any one user's home (see the exports in the Makefile).
.uv/
# Hugging Face cache (tokenizers + base models for the eval-train targets), in-tree for
# the same reason - and because ~/.cache/huggingface is root-owned on the shared box.
.hf/

# --- data, outputs, run state (not version-controlled) ---
# Tracked scaffolds (README/.gitkeep) inside these dirs are force-added.
/data/
/logs/
/reports/
# Large local-only trees (previously only in .git/info/exclude, i.e. per-machine).
argilla_backup/
tmp/
*.log
.pipeline.lock
# Shared by export.sh and freeze.sh, so a freeze cannot copy a tree mid-export.
.export.lock
# GPU-container idle-timeout keep-alive; docs/eval-synthetic-evaluator.md tells operators to create it.
.keep-alive

# --- python caches ---
__pycache__/
*.py[cod]
# OS
.DS_Store
Thumbs.db

# Editor
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv
venv/

# Environment
.env
.env.*
!.env.example
